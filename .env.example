# Salin ke .env lokal untuk pengembangan (jangan commit file .env berisi nilai asli).

# Wajib di server (Vercel / Edge): kunci Gemini — tidak pernah dikirim ke browser.
# Di Vercel: Project → Settings → Environment Variables → GEMINI_API_KEY
GEMINI_API_KEY=

# Catatan: kunci API tidak lagi dipakai dari VITE_* di klien.
# Rate limit API: ~40 permintaan / 15 menit per IP (best-effort di Edge).
